<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <sub-flow name="initialize-job-context-sub-flow">
        <logger level="INFO" doc:name="Start initialize"
                message="#[import * from dwl::common --- logLine(vars.jobId, 'initialize-job-context-sub-flow', 'Start')]"/>
        <ee:transform doc:name="Set job context">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="flowName"><![CDATA[%dw 2.0
output application/java
---
"initialize-job-context-sub-flow"]]></ee:set-variable>
                <ee:set-variable variableName="jobId"><![CDATA[%dw 2.0
output application/java
---
vars.jobId default uuid()]]></ee:set-variable>
                <ee:set-variable variableName="startTime"><![CDATA[%dw 2.0
import * from dwl::common
output application/java
---
tzNow() as String {format: "dd-MM-yyyy HH:mm:ss"}]]></ee:set-variable>
                <ee:set-variable variableName="fileName"><![CDATA[%dw 2.0
output application/java
var raw = vars.fileName default p('sftp.input-filename')
var base = (((raw as String) splitBy "/")[-1] splitBy "\\")[-1]
---
if (isEmpty(base) or (base contains "..")) p('sftp.input-filename') else base]]></ee:set-variable>
                <ee:set-variable variableName="dryRun"><![CDATA[%dw 2.0
output application/java
---
vars.dryRun default (p('migration.dry-run-default') == "true")]]></ee:set-variable>
                <ee:set-variable variableName="sourcePath"><![CDATA[%dw 2.0
import * from dwl::common
output application/java
---
sourcePath(vars.fileName default p('sftp.input-filename'))]]></ee:set-variable>
                <ee:set-variable variableName="mergedCount"><![CDATA[%dw 2.0
output application/java
---
0]]></ee:set-variable>
                <ee:set-variable variableName="totalRecords"><![CDATA[%dw 2.0
output application/java
---
0]]></ee:set-variable>
                <ee:set-variable variableName="successCount"><![CDATA[%dw 2.0
output application/java
---
0]]></ee:set-variable>
                <ee:set-variable variableName="failureCount"><![CDATA[%dw 2.0
output application/java
---
0]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <set-variable variableName="correlationId" value="#[vars.jobId]" doc:name="Use jobId as correlation"/>
        <logger level="INFO" doc:name="End initialize"
                message="#[import * from dwl::common --- logLine(vars.jobId, 'initialize-job-context-sub-flow', 'End file=' ++ vars.fileName ++ ' dryRun=' ++ (vars.dryRun as String))]"/>
    </sub-flow>

    <sub-flow name="acquire-migration-lock-sub-flow">
        <try doc:name="Acquire exclusive lock">
            <os:store key="${migration.lock-key}"
                      objectStore="Migration_Lock_Store"
                      failIfPresent="true"
                      doc:name="Store migration lock">
                <os:value><![CDATA[#[vars.jobId]]]></os:value>
            </os:store>
            <error-handler>
                <on-error-propagate type="OS:KEY_ALREADY_EXISTS, OS:*" doc:name="Lock conflict">
                    <raise-error type="APP:LOCK_NOT_ACQUIRED" description="A migration job is already running"/>
                </on-error-propagate>
            </error-handler>
        </try>
    </sub-flow>

    <sub-flow name="release-migration-lock-sub-flow">
        <try doc:name="Release lock if present">
            <os:contains key="${migration.lock-key}" objectStore="Migration_Lock_Store" target="lockExists" doc:name="Check lock"/>
            <choice doc:name="Remove lock when present">
                <when expression="#[vars.lockExists == true]">
                    <os:remove key="${migration.lock-key}" objectStore="Migration_Lock_Store" doc:name="Remove migration lock"/>
                </when>
            </choice>
            <error-handler>
                <on-error-continue type="ANY" doc:name="Ignore lock release errors">
                    <logger level="WARN" doc:name="Log lock release warning"
                            message="#[import * from dwl::common --- logLine(vars.jobId, 'release-migration-lock-sub-flow', 'Lock release warning: ' ++ (error.description default 'unknown'))]"/>
                </on-error-continue>
            </error-handler>
        </try>
    </sub-flow>

    <sub-flow name="prepare-migration-sub-flow">
        <flow-ref name="initialize-job-context-sub-flow"/>
        <flow-ref name="acquire-migration-lock-sub-flow"/>
        <ee:transform doc:name="Prepare insert-job parameters">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.insert-job')]]></ee:set-variable>
                <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{
    jobId: vars.jobId,
    entity: p('app.entity'),
    status: "ACCEPTED",
    sourceFile: vars.sourcePath,
    correlationId: vars.jobId,
    dryRun: vars.dryRun
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref name="execute-update-sub-flow"/>
        <ee:transform doc:name="Build start notification">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
import * from dwl::apiResponses
output application/java
---
notificationPayload(
    "Migration started",
    vars.jobId,
    "Inventory migration started for file " ++ vars.fileName ++ (if (vars.dryRun) " (dry run)" else ""),
    p('sftp.working-dir') ++ vars.sourcePath,
    { success: true, status: "ACCEPTED" }
)]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <flow-ref name="send-email-sub-flow"/>
    </sub-flow>

    <sub-flow name="complete-job-sub-flow">
        <ee:transform doc:name="Prepare complete-job parameters">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.complete-job')]]></ee:set-variable>
                <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{
    jobId: vars.jobId,
    status: vars.jobStatus default "FAILED",
    totalRecords: vars.totalRecords default 0,
    successCount: vars.successCount default 0,
    failureCount: vars.failureCount default 0,
    mergedCount: vars.mergedCount default 0,
    errorMessage: vars.errorMessage default null
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <try doc:name="Persist job completion">
            <flow-ref name="execute-update-sub-flow"/>
            <error-handler>
                <on-error-continue type="ANY" doc:name="Do not mask original error">
                    <logger level="ERROR" doc:name="Log job update failure"
                            message="#[import * from dwl::common --- logLine(vars.jobId, 'complete-job-sub-flow', 'Failed to persist job status: ' ++ (error.description default 'unknown'))]"/>
                </on-error-continue>
            </error-handler>
        </try>
    </sub-flow>

    <sub-flow name="fail-job-and-notify-sub-flow">
        <set-variable variableName="jobStatus" value="FAILED" doc:name="Mark job failed"/>
        <flow-ref name="complete-job-sub-flow"/>
        <flow-ref name="release-migration-lock-sub-flow"/>
        <ee:transform doc:name="Build failure notification">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
import * from dwl::apiResponses
output application/java
---
notificationPayload(
    "!!! Alert Migration Failed",
    vars.jobId,
    vars.errorMessage default "Migration failed",
    vars.sourcePath default "NA",
    {
        success: false,
        flowName: vars.flowName default "unknown",
        errorCode: vars.errorCode default "INTERNAL_ERROR",
        status: "FAILED"
    }
)]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <flow-ref name="send-email-sub-flow"/>
    </sub-flow>

    <sub-flow name="validate-record-sub-flow">
        <ee:transform doc:name="Evaluate inventory record">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="isValidRecord"><![CDATA[%dw 2.0
import * from dwl::inventoryValidator
output application/java
---
isValid(payload)]]></ee:set-variable>
                <ee:set-variable variableName="recordErrors"><![CDATA[%dw 2.0
import * from dwl::inventoryValidator
output application/java
---
errorDescription(payload)]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <choice doc:name="Fail invalid records">
            <when expression="#[vars.isValidRecord == false]">
                <raise-error type="APP:VALIDATION_FAILED" description="#[vars.recordErrors]"/>
            </when>
        </choice>
    </sub-flow>

    <sub-flow name="attach-error-description-sub-flow">
        <ee:transform doc:name="Attach validation errors">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
import * from dwl::inventoryValidator
output application/java
---
payload ++ {
    ErrorDescription: errorDescription(payload)
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </sub-flow>
</mule>
