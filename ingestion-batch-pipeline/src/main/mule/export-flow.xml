<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <sub-flow name="merge-and-reconcile-sub-flow">
        <logger level="INFO" doc:name="Start merge"
                message="#[import * from dwl::common --- logLine(vars.jobId, 'merge-and-reconcile-sub-flow', 'Start')]"/>
        <ee:transform doc:name="Prepare merge">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.merge-staging')]]></ee:set-variable>
                <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{ jobId: vars.jobId }]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref name="execute-update-sub-flow"/>
        <ee:transform doc:name="Count staging remaining">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.count-staging')]]></ee:set-variable>
                <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{ jobId: vars.jobId }]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref name="execute-select-sub-flow"/>
        <set-variable variableName="stagingRemaining" value="#[payload[0].totalRecord default 0]"/>
        <ee:transform doc:name="Count merged target rows">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.count-target-for-job')]]></ee:set-variable>
                <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{ jobId: vars.jobId }]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref name="execute-select-sub-flow"/>
        <set-variable variableName="mergedCount" value="#[payload[0].totalRecord default 0]"/>
        <choice doc:name="Reconciliation check">
            <when expression="#[(vars.successCount as Number) &gt; 0 and (vars.mergedCount as Number) == 0]">
                <raise-error type="APP:RECONCILIATION_FAILED" description="Valid records were staged but none were merged into the target table"/>
            </when>
            <otherwise>
                <logger level="INFO" doc:name="Log reconciliation"
                        message="#[import * from dwl::common --- logLine(vars.jobId, 'merge-and-reconcile-sub-flow', 'Merged=' ++ (vars.mergedCount as String) ++ ' stagingRemaining=' ++ (vars.stagingRemaining as String))]"/>
            </otherwise>
        </choice>
        <ee:transform doc:name="Clear staging for job">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.delete-staging')]]></ee:set-variable>
                <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{ jobId: vars.jobId }]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref name="execute-update-sub-flow"/>
        <set-variable variableName="jobStatus"
                      value="#[if ((vars.failureCount as Number) &gt; 0) 'PARTIAL' else if ((vars.successCount as Number) == 0) 'FAILED' else 'COMPLETED']"/>
        <logger level="INFO" doc:name="End merge"
                message="#[import * from dwl::common --- logLine(vars.jobId, 'merge-and-reconcile-sub-flow', 'End status=' ++ vars.jobStatus)]"/>
    </sub-flow>

    <sub-flow name="export-results-sub-flow">
        <logger level="INFO" doc:name="Start export"
                message="#[import * from dwl::common --- logLine(vars.jobId, 'export-results-sub-flow', 'Start')]"/>
        <choice doc:name="Export errors when present">
            <when expression="#[(vars.failureCount as Number) &gt; 0]">
                <ee:transform doc:name="Prepare error fetch">
                    <ee:message/>
                    <ee:variables>
                        <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.fetch-errors')]]></ee:set-variable>
                        <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{ jobId: vars.jobId }]]></ee:set-variable>
                        <ee:set-variable variableName="exportPath"><![CDATA[%dw 2.0
import * from dwl::common
output application/java
---
errorExportPath(vars.jobId)]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
                <flow-ref name="execute-select-sub-flow"/>
                <ee:transform doc:name="Errors to CSV">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
import * from dwl::inventoryMapper
output application/csv header=true
---
payload map (row) -> toCsvError(row)]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
                <flow-ref name="write-export-file-sub-flow"/>
            </when>
            <otherwise>
                <logger level="INFO" doc:name="No errors to export"
                        message="#[import * from dwl::common --- logLine(vars.jobId, 'export-results-sub-flow', 'No error records')]"/>
            </otherwise>
        </choice>
        <choice doc:name="Export merged records when present">
            <when expression="#[(vars.mergedCount as Number) &gt; 0]">
                <ee:transform doc:name="Prepare merged fetch">
                    <ee:message/>
                    <ee:variables>
                        <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.fetch-merged')]]></ee:set-variable>
                        <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{ jobId: vars.jobId }]]></ee:set-variable>
                        <ee:set-variable variableName="exportPath"><![CDATA[%dw 2.0
import * from dwl::common
output application/java
---
successExportPath(vars.jobId)]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
                <flow-ref name="execute-select-sub-flow"/>
                <ee:transform doc:name="Merged records to CSV">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
import * from dwl::inventoryMapper
output application/csv header=true
---
payload map (row) -> toCsvSuccess(row)]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
                <flow-ref name="write-export-file-sub-flow"/>
            </when>
        </choice>
        <logger level="INFO" doc:name="End export"
                message="#[import * from dwl::common --- logLine(vars.jobId, 'export-results-sub-flow', 'End')]"/>
    </sub-flow>

    <sub-flow name="archive-and-audit-sub-flow">
        <ee:transform doc:name="Set archive file name">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="archiveFileName"><![CDATA[%dw 2.0
import * from dwl::common
output application/java
---
archiveName(vars.jobId, vars.fileName)]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref name="archive-source-file-sub-flow"/>
        <ee:transform doc:name="Prepare file audit">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.insert-file-audit')]]></ee:set-variable>
                <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{
    fileName: vars.fileName,
    filePath: vars.sourcePath,
    jobId: vars.jobId,
    status: vars.jobStatus
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref name="execute-update-sub-flow"/>
        <choice doc:name="Update watermark on success">
            <when expression="#[vars.jobStatus == 'COMPLETED' or vars.jobStatus == 'PARTIAL']">
                <ee:transform doc:name="Prepare watermark upsert">
                    <ee:message/>
                    <ee:variables>
                        <ee:set-variable variableName="query"><![CDATA[%dw 2.0
output application/java
---
p('query.upsert-watermark')]]></ee:set-variable>
                        <ee:set-variable variableName="inputParameters"><![CDATA[%dw 2.0
output application/java
---
{
    entity: p('app.entity'),
    jobId: vars.jobId
}]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
                <flow-ref name="execute-update-sub-flow"/>
            </when>
        </choice>
    </sub-flow>
</mule>
