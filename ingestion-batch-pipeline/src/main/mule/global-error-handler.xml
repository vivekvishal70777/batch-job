<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <error-handler name="global-error-handler">
        <on-error-propagate type="APP:LOCK_NOT_ACQUIRED" logException="false" doc:name="Lock already held">
            <logger level="WARN" doc:name="Log lock conflict"
                    message="#[import * from dwl::common --- logLine(vars.jobId, vars.flowName default 'unknown', 'Lock not acquired')]"/>
        </on-error-propagate>

        <on-error-continue type="EMAIL:*" logException="true" doc:name="Email failure">
            <logger level="ERROR" doc:name="Log email error"
                    message="#[import * from dwl::common --- logLine(vars.jobId, vars.flowName default 'unknown', 'Email error: ' ++ (error.description default 'Email sending failed'))]"/>
        </on-error-continue>

        <on-error-propagate type="DB:*" logException="true" doc:name="Database failure">
            <set-variable variableName="errorMessage" value="#[error.description default 'Database operation failed']"/>
            <set-variable variableName="errorCode" value="DATABASE_ERROR"/>
            <logger level="ERROR" doc:name="Log DB error"
                    message="#[import * from dwl::common --- logLine(vars.jobId, vars.flowName default 'unknown', 'Database error: ' ++ vars.errorMessage)]"/>
            <flow-ref name="fail-job-and-notify-sub-flow"/>
        </on-error-propagate>

        <on-error-propagate type="SFTP:*" logException="true" doc:name="SFTP failure">
            <set-variable variableName="errorMessage" value="#[error.description default 'SFTP operation failed']"/>
            <set-variable variableName="errorCode" value="SFTP_ERROR"/>
            <logger level="ERROR" doc:name="Log SFTP error"
                    message="#[import * from dwl::common --- logLine(vars.jobId, vars.flowName default 'unknown', 'SFTP error: ' ++ vars.errorMessage ++ ' path=' ++ ((vars.sourcePath default '') as String))]"/>
            <flow-ref name="fail-job-and-notify-sub-flow"/>
        </on-error-propagate>

        <on-error-propagate type="APP:NO_SOURCE, APP:RECONCILIATION_FAILED, APP:MIGRATION_FAILED" logException="true" doc:name="Migration business failure">
            <set-variable variableName="errorMessage" value="#[error.description default 'Migration failed']"/>
            <set-variable variableName="errorCode" value="#[error.errorType.identifier default 'MIGRATION_FAILED']"/>
            <logger level="ERROR" doc:name="Log migration error"
                    message="#[import * from dwl::common --- logLine(vars.jobId, vars.flowName default 'unknown', 'Migration error: ' ++ vars.errorMessage)]"/>
            <flow-ref name="fail-job-and-notify-sub-flow"/>
        </on-error-propagate>

        <on-error-propagate type="ANY" logException="true" doc:name="Unhandled failure">
            <set-variable variableName="errorMessage" value="#[error.description default 'Unexpected internal error']"/>
            <set-variable variableName="errorCode" value="INTERNAL_ERROR"/>
            <logger level="ERROR" doc:name="Log unhandled error"
                    message="#[import * from dwl::common --- logLine(vars.jobId, vars.flowName default 'unknown', 'Unhandled error: ' ++ vars.errorMessage)]"/>
            <flow-ref name="fail-job-and-notify-sub-flow"/>
        </on-error-propagate>
    </error-handler>
</mule>
